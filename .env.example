# ==============================================================================
# ShadowTrace Environment Configuration
# NEVER commit the actual .env file with secrets into version control.
# ==============================================================================

# Flask Secret Key
SECRET_KEY=change_this_to_a_cryptographically_secure_random_key

# Network Interface & Port Binding
# Use 127.0.0.1 for local isolation. Set to 0.0.0.0 only when LAN access is intentionally permitted.
HOST=127.0.0.1
PORT=5005

# Security Settings
DEBUG=False

# CORS Configuration (Restricted origin; avoid using wildcard '*')
CORS_ORIGIN=http://127.0.0.1:5005

# ==============================================================================
# ShadowTrace Environment Configuration
# NEVER commit the actual .env file with secrets into version control.
# ==============================================================================

# Flask Secret Key for signing session cookies (generate with `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=change_this_to_a_cryptographically_secure_random_key

# Admin Authentication Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

# Network Interface & Port Binding
# Use 127.0.0.1 for local isolation. Set to 0.0.0.0 only when LAN access is intentionally permitted and secured.
HOST=127.0.0.1
PORT=5005

# Security & Debugging
DEBUG=False
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# CORS Configuration (Restricted origin; avoid using wildcard '*')
CORS_ORIGIN=http://127.0.0.1:5005

